# URL de base de l'API GymAI (backend Django, préfixe /api/v1).
#
# Défaut si non défini : http://localhost:8000/api/v1
#
# ⚠️ Expo Go sur téléphone PHYSIQUE : `localhost` désigne le téléphone lui-même,
#    PAS ton PC. Mets l'IP LAN de ton PC (celle affichée par `npx expo start`, ou
#    `ipconfig` sous Windows -> « Adresse IPv4 »). Exemple :
#
#    EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1
#
# Émulateur Android (AVD) : http://10.0.2.2:8000/api/v1
# Simulateur iOS         : http://localhost:8000/api/v1
#
# Les variables EXPO_PUBLIC_* sont inlinées au build : redémarre `expo start`
# après modification.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
