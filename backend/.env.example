# ==========================================================================
# GymAI — backend/.env (exemple). Copier vers backend/.env et adapter.
# En DEV, sans DATABASE_URL, le projet utilise SQLite (db.sqlite3) : runnable
# sans Docker ni Postgres.
# ==========================================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données ---
# Laisser vide en DEV -> SQLite. Décommenter pour Postgres (cf docker-compose).
# DATABASE_URL=postgres://gymai:gymai@localhost:5432/gymai

# --- Redis (Celery, Channels) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7

# --- CORS ---
# Origines autorisées (web/mobile). Vide => tout autorisé en DEBUG.
CORS_ALLOWED_ORIGINS=

# --- IA (doc 07) ---
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-sonnet-4-6
AI_PROGRAM_MODEL=claude-opus-4-8
AI_TIMEOUT_S=20
AI_FREE_DAILY_QUOTA=10

# --- Médias / stockage (prod) ---
MEDIA_BACKEND=local            # local | s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# --- Expo push ---
EXPO_ACCESS_TOKEN=

# --- Observabilité ---
SENTRY_DSN=
